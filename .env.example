# Targets. Defaults point at the deployed product, so no configuration is required.
PICKFRAME_WEB_URL=https://pickframe.satuarah.click
PICKFRAME_API_URL=https://api-pickframe.satuarah.click

# Origin the API is expected to allow for browser calls (defaults to the origin of PICKFRAME_WEB_URL).
# PICKFRAME_ALLOWED_ORIGIN=https://pickframe.satuarah.click

# Use an installed browser instead of the bundled Chromium, e.g. "chrome" or "msedge".
# PW_CHANNEL=chrome
